{
  "name": "beszel-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP server for a Beszel monitoring hub — twelve tools over Streamable HTTP and stdio.",
  "license": "MIT",
  "author": "Maxime Bertheau",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxbth/beszel-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/maxbth/beszel-mcp/issues"
  },
  "homepage": "https://github.com/maxbth/beszel-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "beszel",
    "monitoring",
    "observability",
    "bun"
  ],
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --fix",
    "lint:check": "eslint src --max-warnings 0",
    "format": "prettier --write src",
    "build": "bun build src/index.ts --target=bun --outdir dist"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/hono": "^2.0.0",
    "hono": "^4.13.0",
    "pocketbase": "^0.27.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@eslint/js": "^9.27.0",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/bun": "latest",
    "eslint": "^9.30.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unicorn": "^59.0.1",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.5.3",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.33.0"
  }
}
